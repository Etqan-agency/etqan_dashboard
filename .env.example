# Django host WITHOUT the /api suffix — the dashboard appends /api/... itself.
# Leave UNSET to run on built-in sample data.
#   local:      http://localhost:8000
#   production: https://<host>/etqan_api
NEXT_PUBLIC_API_BASE=http://localhost:8000

# The public site the "View site" button opens (defaults to https://www.etqanpp.com).
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
